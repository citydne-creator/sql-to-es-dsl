{
  "name": "sql-to-es-dsl",
  "version": "0.1.0",
  "description": "Compile a bounded SQL subset to Elasticsearch Query DSL",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsup",
    "pack": "npm pack --dry-run"
  },
  "keywords": [
    "elasticsearch",
    "sql",
    "query-dsl",
    "compiler"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/citydne-creator/sql-to-es-dsl.git"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^2.1.9"
  }
}
